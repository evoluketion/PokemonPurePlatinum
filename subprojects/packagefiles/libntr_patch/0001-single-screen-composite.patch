+// Where one engine's output lands inside the window, and how it blends there,
+// under the composited single-screen layout (sim_config's
+// SIM_CONFIG_SCREEN_LAYOUT_MAIN_ONLY). All of this is ignored in the
+// hardware-accurate layouts, where each engine simply fills its own screen.
+//
+// centerX/centerY (0..1) place the center of this engine's output in the
+// window; width/height (0..1) size it as a fraction of the window. The default
+// 0.5/0.5/1.0/1.0 fills the window. Because the window has a single screen's
+// aspect ratio, equal width and height keep the source undistorted - e.g.
+// 0.5/0.5 draws a half-size copy. Anything outside the rect is left to whatever
+// was drawn before it, or to the cleared background if nothing was, which is
+// what gives the black bars when two engines are placed side by side.
+//
+// cutout picks whether this engine is the base or an overlay. FALSE draws it
+// opaquely, backdrop included, so it covers what is underneath - what a base
+// layer wants. TRUE leaves untouched-backdrop pixels transparent so only real
+// drawn content (BG tiles, sprites) appears, letting the base show through
+// around it. Exactly one engine should normally have cutout FALSE; whichever it
+// is gets drawn first automatically, so a screen can hand the base role to
+// either engine.
+//
+// defringe strips the white matte from art that was anti-aliased against an
+// opaque light background. Much of this game's 2D art has near-white pixels
+// baked into its silhouette for that reason - invisible on hardware, where the
+// art has its own light backdrop behind it, but a conspicuous halo once the art
+// is composited over a dark scene. When enabled, silhouette pixels that are
+// essentially greyscale get their alpha reduced by how light they are, so the
+// matte fades while genuine art colors keep full opacity.
+//
+// hidden drops this engine from the composite entirely, as if it had drawn
+// nothing at all. Useful when a scene's content on one engine only made sense
+// as a second physical screen and has no place in the single-screen framing.
+//
+// srcCenterX/srcCenterY/srcWidth/srcHeight select which part of the engine's
+// own output is shown, defaulting to all of it (0.5/0.5/1.0/1.0). This is for
+// scenes that render a picture smaller than the screen and pad it with black:
+// cropping to the picture lets two engines be placed edge to edge without a
+// band of that padding between them. Note the aspect ratio is yours to keep -
+// cropping to a short wide band and then placing it in a tall rect stretches
+// it, so size the destination to match what you cropped.
+typedef struct {
+    float centerX;
+    float centerY;
+    float width;
+    float height;
+    float srcCenterX;
+    float srcCenterY;
+    float srcWidth;
+    float srcHeight;
+    BOOL cutout;
+    BOOL defringe;
+    BOOL hidden;
+} SIM_MainOnlyPlacement;
+
+// The two default composite roles, for initialising a placement before
+// adjusting the fields a caller actually cares about.
+#define SIM_MAIN_ONLY_PLACEMENT_BASE \
+    { 0.5f, 0.5f, 1.0f, 1.0f, 0.5f, 0.5f, 1.0f, 1.0f, FALSE, FALSE, FALSE }
+#define SIM_MAIN_ONLY_PLACEMENT_OVERLAY \
+    { 0.5f, 0.5f, 1.0f, 1.0f, 0.5f, 0.5f, 1.0f, 1.0f, TRUE, FALSE, FALSE }
+
+// Sets how the MAIN (isSub FALSE) or SUB (isSub TRUE) engine is composited under
+// main_only. A screen calls this for itself - nothing is automatic - and should
+// call SIM_ResetMainOnlyPlacements on the way out so it doesn't leave its own
+// framing applied to whatever runs next.
+void SIM_SetMainOnlyPlacement(BOOL isSub, const SIM_MainOnlyPlacement * placement);
+
+// Reads back one engine's current placement, so a caller can adjust a single
+// field without having to restate the rest.
+void SIM_GetMainOnlyPlacement(BOOL isSub, SIM_MainOnlyPlacement * placement);
+
+// Restores the default composite: MAIN filling the window as an opaque base,
+// SUB overlaid on it as a cutout, neither scaled, moved, nor defringed.
+void SIM_ResetMainOnlyPlacements(void);
+
 extern GXVRamTex s_SIM_GXVRamTex;
 extern GXVRamTexPltt s_SIM_GXVRamTexPltt;
 extern GXVRamBGExtPltt s_SIM_GXBgExtPltt;
