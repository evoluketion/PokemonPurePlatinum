+    changed |= ImGui::SliderFloat("src height", &placement.srcHeight, 0.0f, 1.0f, "%.3f");
+
+    if(ImGui::Checkbox("cutout (overlay)", &cutout)) {
+        placement.cutout = cutout ? TRUE : FALSE;
+        changed = true;
+    }
+    if(ImGui::Checkbox("defringe", &defringe)) {
+        placement.defringe = defringe ? TRUE : FALSE;
+        changed = true;
+    }
+    if(ImGui::Checkbox("hidden", &hidden)) {
+        placement.hidden = hidden ? TRUE : FALSE;
+        changed = true;
+    }
+
+    ImGui::PopID();
+
+    if(changed) {
+        SIM_SetMainOnlyPlacement(isSub, &placement);
+    }
+}
+
+void AppPlacementMain(bool *openState) {
+    SIM_config_type * config = SIM_GetConfigPtr();
+
+    ImGui::Begin("Placement", openState);
+
+    if(config->screenLayout != SIM_CONFIG_SCREEN_LAYOUT_MAIN_ONLY) {
+        ImGui::Text("Only applies to the Main Screen Only layout.");
+        ImGui::Text("Current layout ignores these values.");
+        ImGui::Separator();
+    }
+
+    PlacementEditor("MAIN engine", FALSE);
+    ImGui::Separator();
+    PlacementEditor("SUB engine", TRUE);
+    ImGui::Separator();
+
+    if(ImGui::Button("Reset both")) {
+        SIM_ResetMainOnlyPlacements();
+    }
+
+    ImGui::End();
+}
