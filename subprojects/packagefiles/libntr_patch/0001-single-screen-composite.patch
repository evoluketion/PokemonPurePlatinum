+// Live editor for the main_only per-engine placements. Tuning these by eye is
+// the only practical way to frame a scene - the numbers mean nothing until you
+// see the composite - so this exposes them directly rather than requiring a
+// rebuild per adjustment. It also makes the state visible, which matters
+// because a screen setting a placement and failing to put it back looks
+// identical to a scene that simply draws nothing.
+//
+// Values set here last until the game writes them again, which scenes do at
+// their own transitions - so an edit sticks within a scene but is expected to
+// be overwritten when the next one starts.
+static void PlacementEditor(const char * label, BOOL isSub) {
+    SIM_MainOnlyPlacement placement;
+    bool changed = false;
+
+    SIM_GetMainOnlyPlacement(isSub, &placement);
+
+    bool cutout = placement.cutout;
+    bool defringe = placement.defringe;
+    bool hidden = placement.hidden;
+
+    ImGui::Text("%s", label);
+    ImGui::PushID(label);
+
+    changed |= ImGui::SliderFloat("center X", &placement.centerX, 0.0f, 1.0f, "%.3f");
+    changed |= ImGui::SliderFloat("center Y", &placement.centerY, 0.0f, 1.0f, "%.3f");
+    changed |= ImGui::SliderFloat("width", &placement.width, 0.0f, 1.0f, "%.3f");
+    changed |= ImGui::SliderFloat("height", &placement.height, 0.0f, 1.0f, "%.3f");
+
+    changed |= ImGui::SliderFloat("src center X", &placement.srcCenterX, 0.0f, 1.0f, "%.3f");
+    changed |= ImGui::SliderFloat("src center Y", &placement.srcCenterY, 0.0f, 1.0f, "%.3f");
