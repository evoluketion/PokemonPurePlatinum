+// Live editor for the main_only per-engine placements. Tuning these by eye is
+// the only practical way to frame a scene - the numbers mean nothing until you
+// see the composite - so this exposes them directly rather than requiring a
+// rebuild per adjustment. It also makes the state visible, which matters
+// because a screen setting a placement and failing to put it back looks
+// identical to a scene that simply draws nothing.
+//
+// Values set here last until the game writes them again, which scenes do at
+// their own transitions - so an edit sticks within a scene but is expected to
+// be overwritten when the next one starts.
+static void PlacementEditor(const char * aLabel, BOOL aIsSub)
+{
+    SIM_MainOnlyPlacement placement;
+    bool changed = false;
+    bool cutout;
+    bool defringe;
+    bool hidden;
+    char id[64];
+
+    SIM_GetMainOnlyPlacement(aIsSub, &placement);
+
+    cutout = placement.cutout ? true : false;
+    defringe = placement.defringe ? true : false;
+    hidden = placement.hidden ? true : false;
+
+    igText("%s", aLabel);
+
+    snprintf(id, sizeof(id), "center X##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.centerX, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "center Y##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.centerY, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "width##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.width, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "height##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.height, 0.0f, 1.0f, "%.3f", 0);
+
+    snprintf(id, sizeof(id), "src center X##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.srcCenterX, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "src center Y##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.srcCenterY, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "src width##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.srcWidth, 0.0f, 1.0f, "%.3f", 0);
+    snprintf(id, sizeof(id), "src height##%s", aLabel);
+    changed |= igSliderFloat(id, &placement.srcHeight, 0.0f, 1.0f, "%.3f", 0);
+
+    snprintf(id, sizeof(id), "cutout (overlay)##%s", aLabel);
+    if(igCheckbox(id, &cutout)) {
+        placement.cutout = cutout ? TRUE : FALSE;
+        changed = true;
+    }
+    snprintf(id, sizeof(id), "defringe##%s", aLabel);
+    if(igCheckbox(id, &defringe)) {
+        placement.defringe = defringe ? TRUE : FALSE;
+        changed = true;
+    }
+    snprintf(id, sizeof(id), "hidden##%s", aLabel);
+    if(igCheckbox(id, &hidden)) {
+        placement.hidden = hidden ? TRUE : FALSE;
+        changed = true;
+    }
+
+    if(changed) {
+        SIM_SetMainOnlyPlacement(aIsSub, &placement);
+    }
+}
+
+void GUI_AppPlacementMain(bool * p_open)
+{
+    ImVec2 btnSize = {0, 0};
+
+    igBegin("Placement", p_open, 0);
+
+    if(s_SIM_config.screenLayout != SIM_CONFIG_SCREEN_LAYOUT_MAIN_ONLY) {
+        igText("Only applies to the Main Screen Only layout.");
+        igText("Current layout ignores these values.");
+        igSeparator();
+    }
+
+    PlacementEditor("MAIN engine", FALSE);
+    igSeparator();
+    PlacementEditor("SUB engine", TRUE);
+    igSeparator();
+
+    if(igButton("Reset both", btnSize)) {
+        SIM_ResetMainOnlyPlacements();
+    }
+
+    igEnd();
+}
