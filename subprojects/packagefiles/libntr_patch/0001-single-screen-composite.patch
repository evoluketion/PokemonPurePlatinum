+// find which touch-screen pixel is drawn under the cursor. Returns FALSE when
+// the cursor isn't over that engine's output, or the engine is hidden.
+static BOOL SIM_MainOnlyWindowToTouch(int x, int y, int viewX, int viewY,
+                                      int viewWidth, int viewHeight,
+                                      u16 *touchX, u16 *touchY) {
+  // DrawEngine puts the SUB engine on the bottom screen while POWCNT's display
+  // select bit is set, and MAIN there while it's clear.
+  BOOL bottomIsSub = (s_reg_GX_POWCNT >> 15) ? TRUE : FALSE;
+  const SIM_MainOnlyPlacement *placement =
+      &s_SIM_mainOnlyPlacement[bottomIsSub ? 1 : 0];
+
+  if (placement->hidden || viewWidth <= 0 || viewHeight <= 0 ||
+      placement->width <= 0.0f || placement->height <= 0.0f) {
+    return FALSE;
+  }
+
+  // Window coordinates run downwards; the placement's are measured upwards.
+  float s = (float)(x - viewX) / (float)viewWidth;
+  float t = 1.0f - (float)(y - viewY) / (float)viewHeight;
+  float loS = placement->centerX - placement->width * 0.5f;
+  float loT = placement->centerY - placement->height * 0.5f;
+
+  if (s < loS || s > loS + placement->width || t < loT ||
+      t > loT + placement->height) {
+    return FALSE;
+  }
+
+  float srcS = (placement->srcCenterX - placement->srcWidth * 0.5f) +
+               ((s - loS) / placement->width) * placement->srcWidth;
+  float srcT = (placement->srcCenterY - placement->srcHeight * 0.5f) +
+               ((t - loT) / placement->height) * placement->srcHeight;
+
+  if (srcS < 0.0f || srcS > 1.0f || srcT < 0.0f || srcT > 1.0f) {
+    return FALSE;
+  }
+
+  *touchX = (u16)SDL_min((int)(srcS * SIM_NDS_SCREEN_WIDTH),
+                         SIM_NDS_SCREEN_WIDTH - 1);
+  *touchY = (u16)SDL_min((int)((1.0f - srcT) * SIM_NDS_SCREEN_HEIGHT),
+                         SIM_NDS_SCREEN_HEIGHT - 1);
+  return TRUE;
