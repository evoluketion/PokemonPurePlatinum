[wrap-git]
url = https://github.com/cybervisi0n/libntr.git
# Pinned to an exact commit rather than tracking main, because the diff_files
# patch below is authored against this specific tree. Tracking main would mean
# the patch is applied to whatever upstream happens to be at download time,
# so an unrelated upstream commit could break the build for everyone cloning
# this repo, at a moment unconnected to anything changing here. Bump this
# deliberately, re-testing the patch against the new tree when you do.
revision = aa45e528882b447639e42da82ff5631e0adb4fe7
depth = 1
directory = libntr

# Single-screen (main_only) composite support lives in the sim layer, which is
# upstream's code rather than this repo's, so it is carried here as a wrap
# patch - the same way rapidjson/yyjson/zlib/libpng are patched. It applies to
# the exact revision pinned above; if that pin is bumped and this stops
# applying, meson fails loudly at subproject download and the patch needs
# rebasing onto the new base.
diff_files = libntr_patch/0001-single-screen-composite.patch

[provide]
dependency_names = NitroSDK
program_names = makelcf

